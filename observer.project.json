{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v2",
  "image": "python:3.12-slim",
  "build": [["python3", "-m", "pip", "install", "--no-cache-dir", "--disable-pip-version-check", "--target", ".deps", "-r", "requirements.txt"]],
  "run": ["python3", "-u", "agent/minimal_agent.py"],
  "working_directory": ".",
  "environment": {
    "PYTHONPATH": ".deps",
    "PYTHONDONTWRITEBYTECODE": "1",
    "MODEL_PROVIDER": "openai"
  }
}
